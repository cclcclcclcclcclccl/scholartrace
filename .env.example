SCHOLARTRACE_HOST=127.0.0.1
SCHOLARTRACE_PORT=8765
# Optional local inference service. No paid provider is configured.
SCHOLARTRACE_MODEL_URL=http://127.0.0.1:8081/v1
SCHOLARTRACE_MODEL_NAME=local
# Public mode requires HTTPS and an account; registration is closed by default.
SCHOLARTRACE_PUBLIC=0
SCHOLARTRACE_REGISTRATION=0


# For cross-site ModelScope embeds only: set an exact public HTTPS origin.
# SCHOLARTRACE_PUBLIC_ORIGIN=https://your-space.ms.show
SCHOLARTRACE_EMBEDDED=0
